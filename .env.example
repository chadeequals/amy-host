# Copy to Render secret store only. Never commit real values.
PORT=10000
AMY_ENABLED=0
AMY_LLM_API_KEY=
AMY_HOST_API_TOKEN=
AMY_RELAY_TOKEN_SECRET=
TWILIO_AUTH_TOKEN=
CCO_EDGE_BASE_URL=https://ymavyntomunwvtqyhzxs.supabase.co/functions/v1
# Optional OpenAI base (default api.openai.com). Prefer us.api.openai.com when eligible.
OPENAI_API_BASE=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# Prefer /v1/responses with store:false (P2-3). Set 0 to force chat/completions.
OPENAI_USE_RESPONSES=1
# Local unit tests only — never set on Render.
AMY_LLM_MOCK=0

# C22 urgent alert recipients (named backup / RD). Director from center contact on Edge.
# Comma-separated. Leave unset in build — fail closed with log.
# Example (do not commit real prod without Chad): scrochet@handprintschildcare.com
AMY_URGENT_ALERT_TO=
# Set 1 only for Chad-only smoke → remaps To to USAGE_ALERT_TO / celias
AMY_URGENT_ALERT_DRY_RUN=0
